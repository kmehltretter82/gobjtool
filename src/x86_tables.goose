fn escape_raw(major: u8, minor: u8, index: u8) -> u32, bool {
    if major == 1 {
        if minor == 0 { return inat_escape_table_1[index as i64], true; }
        if minor == 1 { return inat_escape_table_1_1[index as i64], true; }
        if minor == 2 { return inat_escape_table_1_2[index as i64], true; }
        if minor == 3 { return inat_escape_table_1_3[index as i64], true; }
        return 0, false;
    }
    if major == 2 {
        if minor == 0 { return inat_escape_table_2[index as i64], true; }
        if minor == 1 { return inat_escape_table_2_1[index as i64], true; }
        if minor == 2 { return inat_escape_table_2_2[index as i64], true; }
        if minor == 3 { return inat_escape_table_2_3[index as i64], true; }
        return 0, false;
    }
    if major == 3 {
        if minor == 0 { return inat_escape_table_3[index as i64], true; }
        if minor == 1 { return inat_escape_table_3_1[index as i64], true; }
        if minor == 2 { return inat_escape_table_3_2[index as i64], true; }
        if minor == 3 { return inat_escape_table_3_3[index as i64], true; }
        return 0, false;
    }
    return 0, false;
}

