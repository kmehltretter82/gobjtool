fn avx_raw(major: u8, minor: u8, index: u8) -> u32, bool {
    if major >= 1 && major <= 3 {
        return escape_raw(major, minor, index);
    }
    if major == 4 {
        if minor == 0 { return inat_avx_table_4[index as i64], true; }
        if minor == 1 { return inat_avx_table_4_1[index as i64], true; }
        if minor == 2 { return inat_avx_table_4_2[index as i64], true; }
        if minor == 3 { return inat_avx_table_4_3[index as i64], true; }
        return 0, false;
    }
    if major == 5 {
        if minor == 0 { return inat_avx_table_5[index as i64], true; }
        if minor == 1 { return inat_avx_table_5_1[index as i64], true; }
        if minor == 2 { return inat_avx_table_5_2[index as i64], true; }
        if minor == 3 { return inat_avx_table_5_3[index as i64], true; }
        return 0, false;
    }
    if major == 6 {
        if minor == 0 { return inat_avx_table_6[index as i64], true; }
        if minor == 1 { return inat_avx_table_6_1[index as i64], true; }
        if minor == 2 { return inat_avx_table_6_2[index as i64], true; }
        if minor == 3 { return inat_avx_table_6_3[index as i64], true; }
        return 0, false;
    }
    if major == 7 {
        if minor == 0 { return inat_avx_table_7[index as i64], true; }
        if minor == 2 { return inat_avx_table_7_2[index as i64], true; }
        if minor == 3 { return inat_avx_table_7_3[index as i64], true; }
        return 0, false;
    }
    return 0, false;
}

fn xop_raw(map_select: u8, index: u8) -> u32, bool {
    if map_select == 8 { return inat_xop_table_0[index as i64], true; }
    if map_select == 9 { return inat_xop_table_1[index as i64], true; }
    if map_select == 10 { return inat_xop_table_2[index as i64], true; }
    return 0, false;
}
